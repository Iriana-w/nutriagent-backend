# ============================================================================
# NutriAgent Backend — Environment Variables
# Copy to .env and fill in your values
# ============================================================================

# --- App ---
APP_NAME=NutriAgent
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Database (PostgreSQL 16 + pgvector) ---
# === LOCAL PostgreSQL ===
# DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/nutriagent
# DATABASE_SYNC_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/nutriagent

# === Supabase PostgreSQL ===
# 1. Enable extensions in Supabase Dashboard: pgcrypto, vector, pg_trgm
# 2. Use port 5432 (session mode), NOT 6543 (PgBouncer/transaction mode)
# 3. URL-encode special characters in password (e.g. / → %2F)
# DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.xxx.supabase.co:5432/postgres
# DATABASE_SYNC_URL=postgresql://postgres:YOUR_PASSWORD@db.xxx.supabase.co:5432/postgres

# === Railway / Render / Fly.io ===
# These platforms auto-inject DATABASE_URL. No manual config needed.
# DATABASE_URL=postgresql+asyncpg://...

# === Common settings ===
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/postgres
DATABASE_SYNC_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/postgres
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# --- JWT ---
# Generate a secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=YOUR_JWT_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- LLM / AI ---
# OpenAI-compatible API (DeepSeek / OpenAI / vLLM / Ollama)
# DeepSeek:  base_url=https://api.deepseek.com/v1  model=deepseek-chat
# OpenAI:    base_url=https://api.openai.com/v1    model=gpt-4o-mini
OPENAI_API_KEY=sk-YOUR_API_KEY
OPENAI_BASE_URL=https://api.deepseek.com/v1
ANTHROPIC_API_KEY=
DEFAULT_LLM_MODEL=deepseek-chat
FAST_LLM_MODEL=deepseek-chat
DEEP_LLM_MODEL=deepseek-chat

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- External Services ---
MEITUAN_API_KEY=
ELEME_API_KEY=

# --- Admin Seed (for setup_database.py / seed_admin.py) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=YOUR_DB_PASSWORD
DB_NAME=postgres
ADMIN_EMAIL=admin@nutriagent.com
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD

# ============================================================================
# NutriAgent Backend — Environment Variables
# Copy to .env and fill in your values
# ============================================================================

# --- App ---
APP_NAME=NutriAgent
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Database (PostgreSQL 16 + pgvector) ---
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/nutriagent
DATABASE_SYNC_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/nutriagent
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# --- JWT ---
# Generate a secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=YOUR_JWT_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- LLM / AI ---
# Supports OpenAI, DeepSeek, or any OpenAI-compatible API
# DeepSeek:  base_url=https://api.deepseek.com/v1  model=deepseek-chat
# OpenAI:    base_url=https://api.openai.com/v1    model=gpt-4o-mini
OPENAI_API_KEY=sk-YOUR_API_KEY
OPENAI_BASE_URL=https://api.deepseek.com/v1
ANTHROPIC_API_KEY=
DEFAULT_LLM_MODEL=deepseek-chat
FAST_LLM_MODEL=deepseek-chat
DEEP_LLM_MODEL=deepseek-chat

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- External Services ---
MEITUAN_API_KEY=
ELEME_API_KEY=

# --- Admin Seed (for setup_database.py / seed_admin.py) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=YOUR_DB_PASSWORD
DB_NAME=nutriagent
ADMIN_EMAIL=admin@nutriagent.com
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD

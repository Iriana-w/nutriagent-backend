# ============================================================================
# NutriAgent Backend — Environment Variables
# Copy to .env and fill in your values
# ============================================================================

# ── App ─────────────────────────────────────────────
APP_NAME=NutriAgent
APP_VERSION=0.1.0
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=WARNING

# ── Server ──────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Database (Supabase PostgreSQL + pgvector) ───────
# Get these from: Supabase Dashboard → Settings → Database → Connection string
# IMPORTANT: Use port 5432 (session), NOT 6543 (PgBouncer)
# URL-encode special chars in password (e.g. / → %2F)
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
DATABASE_SYNC_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_ECHO=false

# ── Supabase API (optional, for future Supabase SDK integration) ──
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=eyJhbGciOi...YOUR_SERVICE_ROLE_KEY

# ── Redis (Upstash) ────────────────────────────────
# Get this from: Upstash Console → Redis Database → REST API → .env
# Format: redis://default:YOUR_TOKEN@YOUR_HOST.upstash.io:6379
REDIS_URL=redis://default:YOUR_TOKEN@YOUR_HOST.upstash.io:6379

# ── JWT ────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=YOUR_JWT_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── LLM / AI ───────────────────────────────────────
# OpenAI-compatible API key (used for both LLM chat and embeddings)
# DeepSeek:  https://platform.deepseek.com/api_keys
# OpenAI:    https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-YOUR_API_KEY
OPENAI_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=sk-YOUR_DEEPSEEK_API_KEY

DEFAULT_LLM_MODEL=deepseek-chat
FAST_LLM_MODEL=deepseek-chat
DEEP_LLM_MODEL=deepseek-chat

# ── CORS ───────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://YOUR_VERCEL_APP.vercel.app,https://YOUR_DOMAIN.com

# ── Rate Limiting ──────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── Admin Seed ─────────────────────────────────────
# Used by setup_database.py and seed_admin.py
ADMIN_EMAIL=admin@nutriagent.com
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD

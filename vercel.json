{
  "functions": {
    "api/index.py": {
      "runtime": "python3.12",
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "backend/**"
    }
  },
  "routes": [
    { "src": "/api/v1/(.*)", "dest": "/api/index.py" },
    { "src": "/docs", "dest": "/api/index.py" },
    { "src": "/openapi.json", "dest": "/api/index.py" },
    { "src": "/api/v1/health", "dest": "/api/index.py" },
    { "src": "/(.*)", "dest": "/api/index.py" }
  ],
  "build": {
    "installCommand": "pip install -r backend/requirements.txt"
  },
  "env": {
    "VERCEL_DEPLOYMENT": "1",
    "ENVIRONMENT": "production",
    "DEBUG": "false"
  }
}
